NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Direct Postgres connection string (same DB the app already used, reached
# without Supabase's client libraries). Example if still hosted on Supabase:
# postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres
# Note: that direct host is IPv6-only. On an IPv4-only host (most cheap VPSes),
# use the Supavisor pooler instead — port 5432 (session) or 6543 (transaction):
# postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learningcoach

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MIN=60

# Cookie session config. Leave COOKIE_SECURE unset to default sensibly
# (false in development, true in production).
COOKIE_DOMAIN=
COOKIE_SECURE=
COOKIE_SAMESITE=lax

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Must stay false in any real deployment — gates POST /v1/payments/:id/simulate
SANDBOX_PAYMENTS_ENABLED=false

# Optional — TTS/STT/dictionary/diagnostic-grading endpoints return a clear
# "not configured" error when this is unset, instead of the app failing to boot.
OPENAI_API_KEY=

# Optional mailer — unset means password-reset emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Learning Coach <learningenglishwithcoach@learningcoach.local>

# Optional — unset means Sentry.init() never runs, no error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
